{
  "version": 2,
  "routes": [
    {
      "src": "/paraphrase",
      "dest": "api/index.py"
    },
    {
      "src": "/summary",
      "dest": "api/index.py"
    },
    {
      "src": "/grammar",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.10",
      "maxDuration": 60
    }
  }
}
