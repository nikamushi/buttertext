{
  "version": 2,
  "routes": [
    {
      "src": "/paraphrase",
      "dest": "api/index.py"
    },
    {
      "src": "/summary",
      "dest": "api/index.py"
    },
    {
      "src": "/grammar",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
